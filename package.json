{
  "name": "hendy-app-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate-structure.mjs",
    "test": "node --test tests/access.test.mjs tests/github-sync.test.mjs tests/self-healing.test.mjs tests/shared-types.test.mjs tests/platform-downloads.test.mjs tests/schema.test.mjs tests/artifact-upload.test.mjs tests/device-detect.test.mjs",
    "build": "npm run build:admin && node scripts/build.mjs",
    "heal:check": "node workers/self-healing-bot/src/index.js --check",
    "heal:repair": "node workers/self-healing-bot/src/index.js --repair",
    "dev": "node scripts/dev-server.mjs",
    "build:admin": "node scripts/build-admin-react.mjs"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "^0.8.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
